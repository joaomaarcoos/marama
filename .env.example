# =========================================
# SUPABASE
# =========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# =========================================
# OPENAI
# =========================================
OPENAI_API_KEY=sk-proj-your_key_here

# =========================================
# EVOLUTION API
# =========================================
EVOLUTION_API_URL=https://your_evolution_api_url.com
EVOLUTION_API_KEY=your_evolution_api_key_here
EVOLUTION_INSTANCE_NAME=your_instance_name

# =========================================
# MOODLE
# =========================================
MOODLE_URL=https://your_moodle_url.com
MOODLE_WSTOKEN=your_moodle_token_here

# =========================================
# SEGURANÇA
# =========================================
WEBHOOK_SECRET=your_webhook_secret_here

# =========================================
# APP
# =========================================
NEXT_PUBLIC_APP_URL=https://your-app-url.com
SIGEC_APP_URL=https://your-app-url.com

# =========================================
# SIGEC — ativar somente após concluir o Gate P1
# O secret do Turnstile fica no painel do Supabase Auth, nunca no frontend.
# =========================================
SIGEC_CANDIDATE_REGISTRATION_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
SIGEC_SUPABASE_CAPTCHA_ENABLED=false
SIGEC_RATE_LIMIT_SECRET=generate_at_least_32_random_characters
SIGEC_WHATSAPP_OTP_SECRET=generate_a_different_32_character_secret
